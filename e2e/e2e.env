# Фиктивные значения только для E2E-стека (deploy/docker-compose.prod.yml + e2e/docker-compose.e2e.yml).
IMAGE=polygon3d
TAG=e2e
DOMAIN=e2e.internal
DJANGO_SECRET_KEY=e2e-secret-key-not-for-production-0123456789
DJANGO_DEBUG=0
DJANGO_HTTPS=1
DJANGO_ALLOWED_HOSTS=e2e.internal
DJANGO_CSRF_TRUSTED_ORIGINS=https://e2e.internal
SITE_URL=https://e2e.internal
SITE_NAME=Polygon3D
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=e2e-db-password
POSTGRES_HOST=db
