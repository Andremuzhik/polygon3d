# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 1 = secure cookies + HSTS (включать в проде за HTTPS)
DJANGO_HTTPS=0
# 1 = доверять X-Forwarded-For (только за reverse proxy; в production compose задан сам)
# DJANGO_BEHIND_PROXY=0
SITE_URL=http://localhost:8000

# --- Студия (отображается на сайте) ---
SITE_NAME=Polygon3D
CONTACT_EMAIL=hello@example.com
CONTACT_PHONE=+7 900 000-00-00

# --- Почта для сброса пароля (без EMAIL_HOST письма печатаются в лог web) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Polygon3D <noreply@example.com>
# Письма клиентам о заказе (заявка принята, статус, ответ менеджера, результат): 0 — отключить
EMAIL_NOTIFICATIONS=1

# --- PostgreSQL (если POSTGRES_DB не задан, используется SQLite) ---
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Telegram-бот (токен получить у @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ID менеджеров через запятую (узнать свой ID: @userinfobot)
TELEGRAM_ADMIN_IDS=

# --- Только для production-деплоя ---
DOMAIN=localhost
